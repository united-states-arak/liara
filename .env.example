# AI provider (OpenAI-compatible). The UI settings dialog can also set these.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-6-luna

# Liara API token. Normally entered in the UI (Settings), stored encrypted in SQLite.
# LIARA_API_TOKEN=

# Encryption key for stored secrets (32 bytes, base64 or hex).
# If unset, a random key is generated once into .data/app-secret.key.
# APP_ENCRYPTION_KEY=

# Hourly checker. Set SCHEDULER_ENABLED=false to disable the in-process scheduler.
# SCHEDULER_ENABLED=true

# Optional: milliseconds between scheduled checks (default 3600000 = hourly, minimum 1000).
# Only change this for testing.
# CHECK_INTERVAL_MS=3600000

# Secret for POST /api/cron/check (external cron on serverless deployments).
# CRON_SECRET=

# SQLite file path. Defaults to .data/starcoach.db.
# DATABASE_PATH=
